prefix_rule(
    pattern = ["git", "push"],
    decision = "forbidden",
    justification = "git push はユーザーが手動で実行する。codex からの push は禁止。",
)

prefix_rule(
    pattern = ["rm", "-rf"],
    decision = "forbidden",
    justification = "rm -rf は破壊的すぎる。個別ファイル削除は rm <path> を使う。",
)

prefix_rule(
    pattern = ["chmod", "777"],
    decision = "forbidden",
    justification = "chmod 777 は権限が過剰。必要な権限を個別に指定する。",
)
