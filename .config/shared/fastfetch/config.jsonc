{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    // "source": "~/.config/fastfetch/mclaren.txt",
    // "source": "~/.config/fastfetch/anime.txt",
    "type": "file",
    "color": {
      // "1": "38;5;208"
      "1": "38;2;203;166;247"
    },
    "padding": {
      "top": 0,
      "left": 0,
      "right": 8
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "1": "38;2;180;190;254",
        "2": "38;2;203;166;247"
      }
    },
    {
      "type": "separator",
      "string": "━",
      "outputColor": "38;2;203;166;247"
    },
    {
      "type": "os",
      "key": "󰍹 OS",
      "keyColor": "38;2;137;180;250"
    },
    {
      "type": "host",
      "key": "󰌢 Host",
      "keyColor": "38;2;116;199;236"
    },
    {
      "type": "kernel",
      "key": "󰣖 Kernel",
      "keyColor": "38;2;137;220;235"
    },
    {
      "type": "bios",
      "key": "󰌷 BIOS",
      "keyColor": "38;2;148;226;213"
    },
    {
      "type": "uptime",
      "key": "󰅐 Uptime",
      "keyColor": "38;2;116;199;236"
    },
    {
      "type": "users",
      "key": "󰀄 Users",
      "keyColor": "38;2;180;190;254"
    },
    {
      "type": "shell",
      "key": "󰆍 Shell",
      "keyColor": "38;2;203;166;247"
    },
    {
      "type": "terminal",
      "key": "󰆍 Terminal",
      "keyColor": "38;2;245;194;231"
    },
    {
      "type": "cpu",
      "key": "󰻠 CPU",
      "keyColor": "38;2;235;160;172"
    },
    {
      "type": "command",
      "key": "󰢮 GPU",
      "keyColor": "38;2;243;139;168",
      "text": "nvidia-smi --query-gpu=name,memory.total --format=csv,noheader"
    },
    {
      "type": "memory",
      "key": "󰍛 Memory",
      "keyColor": "38;2;250;179;135"
    },
    {
      "type": "disk",
      "key": "󰋊 Disk",
      "keyColor": "38;2;249;226;175"
    },
    "break",
    {
      "type": "command",
      "key": " ",
      "keyWidth": 0,
      "shell": "zsh",
      "text": "python \"$HOME/.config/fastfetch/show_music.py\" 2>/dev/null",
      "format": "{result}",
      "splitLines": true
    }
  ]
}
