.shell powershell

# Reload komorebi configuration
win + r                 : komorebic reload-configuration

# Show whkd shortcut overlay
win + oem_2             : komorebic toggle-shortcuts # oem_2 is /

# App shortcuts - these require shell to be pwsh / powershell
# The apps will be focused if open, or launched if not open
# win + f                 : if ($wshell.AppActivate('Firefox') -eq $False) { start firefox }
# win + b                 : if ($wshell.AppActivate('Chrome') -eq $False) { start chrome }

win + q                 : komorebic close
win + m                 : komorebic minimize

# Focus windows (alt + uiop)
alt + left              : komorebic focus left
alt + down              : komorebic focus down
alt + up                : komorebic focus up
alt + right             : komorebic focus right
win + shift + oem_4     : komorebic cycle-focus previous # oem_4 is [
win + shift + oem_6     : komorebic cycle-focus next # oem_6 is ]

# Preselect split direction for next window (win + uiop) — 次に開くウィンドウの配置先を指定
win + u                 : komorebic preselect-direction left
win + i                 : komorebic preselect-direction down
win + o                 : komorebic preselect-direction up
win + p                 : komorebic preselect-direction right
win + shift + return    : komorebic promote

# Swap/move focused window with neighbor (win + shift + uiop)
win + shift + u         : komorebic move left
win + shift + i         : komorebic move down
win + shift + o         : komorebic move up
win + shift + p         : komorebic move right

# Stack windows
win + left              : komorebic stack left
win + down              : komorebic stack down
win + up                : komorebic stack up
win + right             : komorebic stack right
win + oem_1             : komorebic unstack # oem_1 is ;
win + oem_4             : komorebic cycle-stack previous # oem_4 is [
win + oem_6             : komorebic cycle-stack next # oem_6 is ]

# Resize
win + oem_plus          : komorebic resize-axis horizontal increase
win + oem_minus         : komorebic resize-axis horizontal decrease
win + shift + oem_plus  : komorebic resize-axis vertical increase
win + shift + oem_minus : komorebic resize-axis vertical decrease

# Manipulate windows
win + t                 : komorebic toggle-float
win + shift + f         : komorebic toggle-monocle

# Window manager options
win + shift + r         : komorebic stop --whkd; Start-Sleep -Seconds 2; Start-Process komorebic -ArgumentList 'start','--whkd' -WindowStyle Hidden
win + z                 : komorebic toggle-pause

# Layouts
win + x                 : komorebic flip-layout horizontal
win + y                 : komorebic flip-layout vertical

# Workspaces (両モニター同時切替 — focus-workspaces は全モニターを同じ index へ)
win + 1                 : komorebic focus-workspaces 0          # WS 1: M0=wezterm, M1=vscode+brave
win + 2                 : komorebic focus-workspaces 1          # WS 2: (M1 empty)
win + 3                 : komorebic focus-workspaces 2          # WS 3: M0=slack/spotify, M1=chrome

# Move current window to a workspace on the focused monitor
win + alt + 1           : komorebic move-to-workspace 0
win + alt + 2           : komorebic move-to-workspace 1
win + alt + 3           : komorebic move-to-workspace 2

# Monitors (multi-monitor focus/move)
win + oem_comma         : komorebic focus-monitor 0      # , — main (WezTerm/Discord/Spotify)
win + oem_period        : komorebic focus-monitor 1      # . — sub (VSCode/Browser)
win + shift + oem_comma : komorebic move-to-monitor 0
win + shift + oem_period: komorebic move-to-monitor 1
win + n                 : komorebic cycle-monitor next
win + shift + n         : komorebic cycle-monitor previous

# Morning setup — 常用アプリを一括起動してワークスペースへ自動振り分け
alt + insert            : & "$env:USERPROFILE\Project\github.com\t4ko0522\dotfiles\.bin\morning_setup.ps1"