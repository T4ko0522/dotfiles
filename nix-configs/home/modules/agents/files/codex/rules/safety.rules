# 破壊的・公開操作は、Codex が自動実行できないようにする。
prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "リモートへ変更を送信する前にユーザーへ確認する。",
    match = [
        "git push",
        "git push origin HEAD",
        "git push --force-with-lease",
    ],
    not_match = [
        "git status",
        "git -C /tmp push origin HEAD",
    ],
)

# `git -C <path> push` ではサブコマンドの位置が変わるため、
# `git -C` を使うすべての操作を確認対象にする。
prefix_rule(
    pattern = ["git", "-C"],
    decision = "prompt",
    justification = "git -C は別の作業ツリーに対して push を実行できるため、ユーザーへ確認する。",
    match = [
        "git -C /tmp status",
        "git -C /tmp push origin HEAD",
    ],
    not_match = [
        "git status",
        "git push origin HEAD",
    ],
)

prefix_rule(
    pattern = ["nh"],
    decision = "forbidden",
    justification = "nh 関連の操作はユーザーが手動で実行する。Codex からの実行は禁止。",
)

prefix_rule(
    pattern = ["rm", "-rf"],
    decision = "forbidden",
    justification = "rm -rf は破壊的すぎる。個別ファイル削除は rm <path> を使う。",
)

prefix_rule(
    pattern = ["chmod", "777"],
    decision = "forbidden",
    justification = "chmod 777 は権限が過剰。必要な権限を個別に指定する。",
)

# Codex がシェルラッパーを使う場合、内側のコマンドに対する prefix_rule を
# すり抜けないよう、ラッパー自体を必ずユーザー確認付きにする。
prefix_rule(
    pattern = ["/bin/zsh", "-lc"],
    decision = "prompt",
    justification = "シェルラッパー経由のコマンドは内容を確認してから実行する。",
)

prefix_rule(
    pattern = ["/bin/bash", "-lc"],
    decision = "prompt",
    justification = "シェルラッパー経由のコマンドは内容を確認してから実行する。",
)
