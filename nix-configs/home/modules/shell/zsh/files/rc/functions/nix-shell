#!/usr/bin/env zsh
# `nix-shell` (旧 API) も同様に zsh で起動するラッパー。
# nix() の develop 版と同じ方針: 対話的に入る場合だけ --command zsh を補う。

emulate -L zsh

if [[ -t 1 ]]; then
  local arg
  for arg in "$@"; do
    case "$arg" in
      --run | --command | --exec | -h | --help | --version)
        command nix-shell "$@"
        return
        ;;
    esac
  done
  # nix() と同様に dev shell 内では starship を Nix テーマ配色に差し替える。
  local nix_starship="${XDG_CONFIG_HOME:-$HOME/.config}/zsh/starship-nix.toml"
  if [[ -r "$nix_starship" ]]; then
    STARSHIP_CONFIG="$nix_starship" command nix-shell "$@" --command zsh
  else
    command nix-shell "$@" --command zsh
  fi
  return
fi

command nix-shell "$@"
