#!/bin/sh
# prepare-commit-msg: conventional commit prefix に gitmoji を自動挿入する
# 例: "feat: add feature" → "feat: ✨ add feature"

COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="$2"

# merge, squash, amend 等はスキップ
case "$COMMIT_SOURCE" in
  merge|squash) exit 0 ;;
esac

# 先頭行を取得
first_line=$(head -n1 "$COMMIT_MSG_FILE")

# "ngm " プレフィックス付きなら gitmoji をスキップし、プレフィックスだけ除去
case "$first_line" in
  ngm\ *)
    sed -i '1s/^ngm //' "$COMMIT_MSG_FILE"
    exit 0
    ;;
esac

# "gm " プレフィックス付きなら conventional type を gitmoji に置換 (type を残さない)
# 例: "gm feat: add" → "✨ add" / "gm fix(auth): bug" → "🐛 bug"
case "$first_line" in
  gm\ *)
    sed -i '1s/^gm //' "$COMMIT_MSG_FILE"
    first_line=$(head -n1 "$COMMIT_MSG_FILE")
    emoji=""
    case "$first_line" in
      feat:*|feat\(*\):*)         emoji="✨" ;;
      fix:*|fix\(*\):*)           emoji="🐛" ;;
      docs:*|docs\(*\):*)         emoji="📝" ;;
      style:*|style\(*\):*)       emoji="💄" ;;
      refactor:*|refactor\(*\):*) emoji="♻️" ;;
      perf:*|perf\(*\):*)         emoji="⚡️" ;;
      test:*|test\(*\):*)         emoji="✅" ;;
      build:*|build\(*\):*)       emoji="👷" ;;
      ci:*|ci\(*\):*)             emoji="🎡" ;;
      chore:*|chore\(*\):*)       emoji="🔧" ;;
      remove:*|remove\(*\):*)     emoji="🔥" ;;
      deploy:*|deploy\(*\):*)     emoji="🚀" ;;
    esac
    if [ -n "$emoji" ]; then
      sed -i "1s/^[a-z][a-z]*\(([^)]*)\)\{0,1\}: /$emoji /" "$COMMIT_MSG_FILE"
    fi
    exit 0
    ;;
esac

# 既に gitmoji が含まれていればスキップ（二重挿入防止）
case "$first_line" in
  *✨*|*🐛*|*📝*|*💄*|*♻️*|*⚡️*|*✅*|*👷*|*🎡*|*🔧*|*🔥*|*🚀*) exit 0 ;;
esac

# prefix から gitmoji を決定（scope 付き "type(scope):" にも対応）
emoji=""
case "$first_line" in
  feat:*|feat\(*\):*)         emoji="✨" ;;
  fix:*|fix\(*\):*)           emoji="🐛" ;;
  docs:*|docs\(*\):*)         emoji="📝" ;;
  style:*|style\(*\):*)       emoji="💄" ;;
  refactor:*|refactor\(*\):*) emoji="♻️" ;;
  perf:*|perf\(*\):*)         emoji="⚡️" ;;
  test:*|test\(*\):*)         emoji="✅" ;;
  build:*|build\(*\):*)       emoji="👷" ;;
  ci:*|ci\(*\):*)             emoji="🎡" ;;
  chore:*|chore\(*\):*)       emoji="🔧" ;;
  remove:*|remove\(*\):*)     emoji="🔥" ;;
  deploy:*|deploy\(*\):*)     emoji="🚀" ;;
esac

if [ -z "$emoji" ]; then
  exit 0
fi

# "type: description" または "type(scope): description" → prefix の直後に emoji を挿入
sed -i "1s/^\([a-z][a-z]*\(([^)]*)\)\{0,1\}:\) /\1 $emoji /" "$COMMIT_MSG_FILE"
